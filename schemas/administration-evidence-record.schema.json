{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gsa/schemas/0.1.0-alpha.1/administration-evidence-record.schema.json",
  "title": "AdministrationEvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "created_at",
    "artifact_refs",
    "artifact_hashes",
    "canonicalization_profile",
    "redaction_status",
    "source_classification",
    "assurance_limitations",
    "event_occurrence_claimed",
    "authorization_effect",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-alpha.1"
    },
    "evidence_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/date_time"
    },
    "artifact_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "context",
        "analysis",
        "review",
        "validation"
      ],
      "properties": {
        "request": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "context": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "analysis": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "review": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "validation": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "context",
        "analysis",
        "review",
        "validation"
      ],
      "properties": {
        "request": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "context": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "analysis": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "review": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "validation": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "canonicalization_profile": {
      "const": "GSA-CJSON-1"
    },
    "redaction_status": {
      "enum": [
        "NOT_REQUIRED_SYNTHETIC",
        "REDACTED_CONFIGURED_PATTERNS",
        "NOT_EVALUATED"
      ]
    },
    "source_classification": {
      "$ref": "common.schema.json#/$defs/source_classification"
    },
    "assurance_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "event_occurrence_claimed": {
      "const": false
    },
    "authorization_effect": {
      "const": "NONE"
    },
    "execution_authorized": {
      "const": false
    }
  },
  "$comment": "Proposed normative; approval status under review; product implementation not started."
}
