{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gsa/schemas/0.1.0-alpha.1/review-requirement.schema.json",
  "title": "ReviewRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "analysis_id",
    "disposition",
    "matched_policy_rule",
    "required_reviewer_role",
    "required_evidence",
    "conditions",
    "prohibited_outcomes",
    "expires_at",
    "separation_of_duty_required",
    "reasons",
    "authorization_effect",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-alpha.1"
    },
    "review_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "analysis_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "disposition": {
      "$ref": "common.schema.json#/$defs/disposition"
    },
    "matched_policy_rule": {
      "type": "string",
      "pattern": "^POL-(001|002|004|005|006|007|008|009|010|011|012|013|014|015|016)$"
    },
    "required_reviewer_role": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "prohibited_outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "expires_at": {
      "anyOf": [
        {
          "$ref": "https://example.invalid/gsa/schemas/0.1.0-alpha.1/common.schema.json#/$defs/date_time"
        },
        {
          "type": "null"
        }
      ]
    },
    "separation_of_duty_required": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "authorization_effect": {
      "const": "NONE"
    },
    "execution_authorized": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "NO_ESCALATION_REQUIRED_BY_REFERENCE_POLICY"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "matched_policy_rule": {
            "const": "POL-015"
          },
          "required_reviewer_role": {
            "type": "null"
          },
          "expires_at": {
            "type": "null"
          },
          "separation_of_duty_required": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "HUMAN_REVIEW_REQUIRED"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "matched_policy_rule": {
            "enum": [
              "POL-009",
              "POL-010",
              "POL-013",
              "POL-014",
              "POL-016"
            ]
          },
          "required_reviewer_role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "PROHIBITED_BY_REFERENCE_POLICY"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "matched_policy_rule": {
            "enum": [
              "POL-001",
              "POL-002",
              "POL-007",
              "POL-008"
            ]
          },
          "required_reviewer_role": {
            "type": "null"
          },
          "expires_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "INDETERMINATE"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "matched_policy_rule": {
            "enum": [
              "POL-004",
              "POL-005",
              "POL-006",
              "POL-011",
              "POL-012"
            ]
          }
        }
      }
    }
  ],
  "$comment": "Proposed normative; approval status under review; product implementation not started."
}
