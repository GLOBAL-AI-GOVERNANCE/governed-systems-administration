{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gsa/schemas/0.1.0-alpha.1/acceptance-suite.schema.json",
  "title": "AcceptanceSuite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_version",
    "approval_status",
    "normative_status",
    "implementation_status",
    "cases"
  ],
  "properties": {
    "suite_version": {
      "const": "0.1.0-alpha.1"
    },
    "approval_status": {
      "const": "UNDER_REVIEW"
    },
    "normative_status": {
      "const": "PROPOSED_NORMATIVE"
    },
    "implementation_status": {
      "const": "NOT_STARTED"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "acceptance-case.schema.json"
      }
    }
  },
  "$comment": "Proposed normative; approval status under review; product implementation not started."
}
