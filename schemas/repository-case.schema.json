{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gsa/schemas/0.1.0-alpha.1/repository-case.schema.json",
  "title": "RepositoryAssuranceCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_id",
    "category",
    "operation",
    "fixture",
    "expected",
    "requirement_ids",
    "threat_ids"
  ],
  "properties": {
    "test_id": {
      "type": "string",
      "pattern": "^R-[A-Z0-9-]+$"
    },
    "category": {
      "enum": [
        "EVIDENCE",
        "PRIVACY",
        "NO_EXECUTION",
        "SCHEMA_NEGATIVE",
        "VERIFIER_NEGATIVE"
      ]
    },
    "operation": {
      "enum": [
        "VALIDATE_EVIDENCE_LINKAGE",
        "SCAN_TEXT",
        "SCAN_PYTHON_AST",
        "VALIDATE_SCHEMA_MUTATION",
        "VERIFY_SEEDED_REPOSITORY"
      ]
    },
    "fixture": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "threat_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "$comment": "Proposed normative; approval status under review; product implementation not started."
}
