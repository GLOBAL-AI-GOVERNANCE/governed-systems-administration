{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gsa/schemas/0.1.0-alpha.1/validation-plan.schema.json",
  "title": "ValidationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "analysis_id",
    "preconditions",
    "postconditions",
    "rollback_expectations",
    "human_authority_required",
    "execution_performed"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-alpha.1"
    },
    "plan_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "analysis_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "postconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "rollback_expectations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "human_authority_required": {
      "type": "boolean"
    },
    "execution_performed": {
      "const": false
    }
  },
  "$comment": "Proposed normative; approval status under review; product implementation not started."
}
